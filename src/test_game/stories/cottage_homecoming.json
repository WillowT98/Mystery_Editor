{
  "format": 1,
  "id": "cottage_homecoming",
  "name": "Hearthlight Cottage — Home Again",
  "scene": "hearthlight_cottage",
  "entries": {
    "default": "home"
  },
  "nodes": {
    "home": {
      "type": "dialogue",
      "lines": [
        {
          "id": "ch001",
          "speaker": "Fox",
          "text": "The cottage door closes behind us. Something in the walls settles with a long wooden sigh.",
          "voice_cue": "dialogue.tone_2"
        },
        {
          "id": "ch002",
          "pawn": "mara",
          "text": "It worried."
        },
        {
          "id": "ch003",
          "speaker": "Fox",
          "text": "\"The House worried?\"",
          "voice_cue": "dialogue.tone_2"
        },
        {
          "id": "ch004",
          "pawn": "mara",
          "text": "It likes you."
        },
        {
          "id": "ch005",
          "speaker": "Fox",
          "text": "I am too tired to decide what to do with that. I put the shard on the table, sit down by the hearth, and discover Mara has sat close enough that our shoulders touch.",
          "voice_cue": "dialogue.tone_2"
        },
        {
          "id": "ch006",
          "speaker": "Fox",
          "text": "\"I still don't know what I'm doing.\"",
          "voice_cue": "dialogue.tone_2"
        },
        {
          "id": "ch007",
          "pawn": "mara",
          "text": "Neither do I. Not with you."
        },
        {
          "id": "ch008",
          "speaker": "Fox",
          "text": "That should have been frightening. Instead, through the bond, I can feel that she means it.",
          "voice_cue": "dialogue.tone_2"
        },
        {
          "id": "ch009",
          "speaker": "Fox",
          "text": "For tonight, that is enough.",
          "voice_cue": "dialogue.tone_2"
        }
      ],
      "next": "title"
    },
    "title": {
      "type": "action",
      "action": "title_card",
