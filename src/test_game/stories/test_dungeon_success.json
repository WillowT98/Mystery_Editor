    "dialogue": {
      "type": "dialogue",
      "lines": [
        {
          "id": "ds001",
          "speaker": "Fox",
          "text": "The meadow air hits differently after three floors of old stone and things with teeth.",
          "voice_cue": "dialogue.tone_2"
        },
        {
          "id": "ds002",
          "pawn": "mara",
          "text": "You did well."
        },
        {
          "id": "ds003",
          "speaker": "Fox",
          "text": "\"We did well. I mostly discovered several exciting new ways to panic while moving forward.\"",
          "voice_cue": "dialogue.tone_2"
        },
        {
          "id": "ds004",
          "pawn": "mara",
          "text": "Moving forward while frightened is generally what courage looks like from the inside."
        },
        {
          "id": "ds005",
          "speaker": "Fox",
          "text": "I turn the warm shard over in my palm. Through the bond I can feel Mara's exhaustion under the satisfaction.",
          "voice_cue": "dialogue.tone_2"
        },
        {
          "id": "ds006",
          "speaker": "Fox",
          "text": "\"Home?\"",
          "voice_cue": "dialogue.tone_2"
        },
        {
          "id": "ds007",
          "pawn": "mara",
          "text": "Home."
        }
      ],
